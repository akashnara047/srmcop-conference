rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'akashnara047@gmail.com' ||
        request.auth.token.email == 'dean.pharmacy.ktr@srmist.edu.in' ||
        request.auth.token.email == 'org.secy.cp@srmist.edu.in' ||
        request.auth.token.email == 'narayanj@srmist.edu.in' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // System Counters for Atomic Sequential ID Allocation
    match /systemCounters/{counterId} {
      allow read: if true;
      allow write: if isAdmin() || counterId == 'abstractCounter' || counterId == 'registrationCounter';
    }

    // Abstract Submissions
    // Public can create abstracts and look up their own abstract by ID for tracking
    match /abstractSubmissions/{abstractId} {
      allow create: if isValidId(abstractId) &&
        request.resource.data.keys().hasAll(['id', 'registrationId', 'title', 'trackId', 'presentationPreference', 'presentingAuthor', 'status', 'createdAt']) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 500 &&
        request.resource.data.registrationId is string && request.resource.data.registrationId.size() <= 50;

      allow get: if isValidId(abstractId);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Registrations
    // Public can create with initial 'Pending Verification' and 'Awaiting Approval'
    // Public can get their own registration by ID (or query by email/ID for tracking)
    // Admins can list, update verification, assign registrationId, and delete
    match /registrations/{registrationId} {
      allow create: if isValidId(registrationId) &&
        request.resource.data.keys().hasAll(['id', 'fullName', 'email', 'mobile', 'institution', 'category', 'transactionReference', 'paymentStatus', 'registrationStatus', 'createdAt']) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 200 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 150 &&
        request.resource.data.paymentStatus in ['Pending Verification', 'Under Verification'] &&
        request.resource.data.registrationStatus == 'Awaiting Approval';

      allow get: if isValidId(registrationId);
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        // Allow abstract submission transaction to update linkedAbstractId and abstractSubmitted
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedAbstractId', 'abstractSubmitted', 'abstractSubmissionDate', 'updatedAt'])
      ) || (
        // Allow participant to resubmit transaction ref if status was Rejected
        resource.data.paymentStatus == 'Rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transactionReference', 'paymentReceiptName', 'paymentReceiptData', 'paymentStatus', 'updatedAt']) &&
        request.resource.data.paymentStatus == 'Pending Verification'
      );
      allow delete: if isAdmin();
    }

    // Contact Enquiries
    match /contactEnquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) &&
        request.resource.data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'createdAt']);
      allow get, list, update, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Validation helpers for Hospitality Directory (Accommodation & Places to Visit)
    function isValidAccommodationProperty(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'locality', 'address', 'phone', 'distanceKm', 'mapsQuery', 'isActive', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'category', 'locality', 'address', 'phone', 'secondaryPhone', 'phoneTypeNote', 'distanceKm', 'driveMinutes', 'mapsQuery', 'isActive', 'updatedAt', 'updatedBy']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        data.category in ['Hotel', 'Guest House', 'Residency', 'Homestay'] &&
        data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 100 &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 400 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 50 &&
        (!('secondaryPhone' in data) || data.secondaryPhone == null || (data.secondaryPhone is string && data.secondaryPhone.size() <= 50)) &&
        (!('phoneTypeNote' in data) || data.phoneTypeNote == null || (data.phoneTypeNote is string && data.phoneTypeNote.size() <= 120)) &&
        data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 500 &&
        (!('driveMinutes' in data) || data.driveMinutes == null || (data.driveMinutes is number && data.driveMinutes >= 0 && data.driveMinutes <= 1000)) &&
        data.mapsQuery is string && data.mapsQuery.size() >= 3 && data.mapsQuery.size() <= 300 &&
        data.isActive is bool &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 150));
    }

    function isValidTouristAttraction(data) {
      return data.keys().hasAll(['id', 'name', 'locality', 'description', 'distanceKm', 'mapsQuery', 'isActive', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'locality', 'description', 'distanceKm', 'driveMinutes', 'image', 'mapsQuery', 'isActive', 'updatedAt', 'updatedBy']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 400 &&
        data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 500 &&
        (!('driveMinutes' in data) || data.driveMinutes == null || (data.driveMinutes is number && data.driveMinutes >= 0 && data.driveMinutes <= 1000)) &&
        (!('image' in data) || data.image == null || (data.image is string && data.image.size() <= 500)) &&
        data.mapsQuery is string && data.mapsQuery.size() >= 3 && data.mapsQuery.size() <= 300 &&
        data.isActive is bool &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 150));
    }

    // Conference Accommodation Directory (public read-only, admin-managed write)
    match /accommodationProperties/{propertyId} {
      allow get: if isValidId(propertyId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(propertyId) && isValidAccommodationProperty(request.resource.data) && request.resource.data.id == propertyId;
      allow update: if isAdmin() && isValidId(propertyId) && isValidAccommodationProperty(request.resource.data) && request.resource.data.id == propertyId;
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    // Tourist Attractions Directory (public read-only, admin-managed write)
    match /touristAttractions/{attractionId} {
      allow get: if isValidId(attractionId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(attractionId) && isValidTouristAttraction(request.resource.data) && request.resource.data.id == attractionId;
      allow update: if isAdmin() && isValidId(attractionId) && isValidTouristAttraction(request.resource.data) && request.resource.data.id == attractionId;
      allow delete: if isAdmin() && isValidId(attractionId);
    }

    // Email Notification Logs (idempotent Pending create, Pending->Sent/Failed completion, Sent immutable, admin retry & audit read)
    function isValidEmailLogCreate(data, logId) {
      return data.keys().hasAll(['id', 'eventId', 'type', 'referenceId', 'recipient', 'subject', 'status', 'attemptCount', 'createdAt', 'lastAttemptedAt', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'eventId', 'type', 'referenceId', 'registrationId', 'regDocId',
          'abstractId', 'recipient', 'subject', 'status', 'attemptCount',
          'createdAt', 'lastAttemptedAt', 'sentAt', 'error', 'hasAttachment',
          'attachmentName', 'triggeredBy', 'duplicatePrevented', 'providerService',
          'recordType', 'timestamp', 'updatedAt'
        ]) &&
        data.id == logId &&
        data.eventId == logId &&
        data.type in ['registration_received', 'registration_confirmation', 'abstract_confirmation', 'abstract_acceptance'] &&
        data.status == 'Pending' &&
        data.attemptCount is int && data.attemptCount == 1 &&
        data.referenceId is string && data.referenceId.size() >= 3 && data.referenceId.size() <= 128 &&
        data.recipient is string && data.recipient.size() >= 3 && data.recipient.size() <= 200 &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 250 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.lastAttemptedAt is string && data.lastAttemptedAt.size() <= 50 &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        (!('sentAt' in data) || data.sentAt == null) &&
        (!('error' in data) || data.error == null) &&
        (!('hasAttachment' in data) || data.hasAttachment is bool) &&
        (!('attachmentName' in data) || data.attachmentName == null || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
        (!('triggeredBy' in data) || (data.triggeredBy is string && data.triggeredBy.size() <= 150)) &&
        (!('duplicatePrevented' in data) || data.duplicatePrevented is bool) &&
        (!('providerService' in data) || data.providerService == null || (data.providerService is string && data.providerService.size() <= 120)) &&
        (!('recordType' in data) || data.recordType in ['live', 'test']);
    }

    function isValidEmailLogUpdate(newData, oldData) {
      return newData.keys().hasOnly([
          'id', 'eventId', 'type', 'referenceId', 'registrationId', 'regDocId',
          'abstractId', 'recipient', 'subject', 'status', 'attemptCount',
          'createdAt', 'lastAttemptedAt', 'sentAt', 'error', 'hasAttachment',
          'attachmentName', 'triggeredBy', 'duplicatePrevented', 'providerService',
          'recordType', 'timestamp', 'updatedAt'
        ]) &&
        newData.id == oldData.id &&
        newData.eventId == oldData.eventId &&
        newData.type == oldData.type &&
        newData.referenceId == oldData.referenceId &&
        newData.createdAt == oldData.createdAt &&
        newData.status in ['Pending', 'Sent', 'Failed'] &&
        newData.attemptCount is int && newData.attemptCount >= 1 && newData.attemptCount <= 50 &&
        newData.lastAttemptedAt is string && newData.lastAttemptedAt.size() <= 50 &&
        (!('sentAt' in newData) || newData.sentAt == null || (newData.sentAt is string && newData.sentAt.size() <= 50)) &&
        (!('error' in newData) || newData.error == null || (newData.error is string && newData.error.size() <= 500));
    }

    function isValidPublicEmailLogCompletion(newData, oldData) {
      return oldData.status == 'Pending' &&
        oldData.type in ['registration_received', 'abstract_confirmation'] &&
        newData.status in ['Sent', 'Failed'] &&
        newData.recipient == oldData.recipient &&
        newData.subject == oldData.subject &&
        newData.attemptCount == oldData.attemptCount;
    }

    match /emailLogs/{logId} {
      allow create: if isValidId(logId) &&
        isValidEmailLogCreate(request.resource.data, logId) &&
        (isAdmin() || request.resource.data.type in ['registration_received', 'abstract_confirmation']);
      allow get, list: if isAdmin();
      allow update: if isValidId(logId) &&
        resource.data.status != 'Sent' &&
        resource.data.status != 'Delivered' &&
        isValidEmailLogUpdate(request.resource.data, resource.data) &&
        (isAdmin() || isValidPublicEmailLogCompletion(request.resource.data, resource.data));
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Validation helper for Database Backup metadata logs
    function isValidDatabaseBackup(data) {
      return data.keys().hasAll(['id', 'createdAt', 'filename', 'initiatedBy', 'status', 'errorCount', 'storageFilesCount', 'totalArchiveBytes', 'recordCounts']) &&
        data.keys().hasOnly(['id', 'createdAt', 'filename', 'initiatedBy', 'status', 'errorCount', 'storageFilesCount', 'totalArchiveBytes', 'recordCounts', 'storageSummary', 'errors']) &&
        isValidId(data.id) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.filename is string && data.filename.size() >= 5 && data.filename.size() <= 200 &&
        data.initiatedBy is string && data.initiatedBy.size() >= 3 && data.initiatedBy.size() <= 150 &&
        data.status in ['complete', 'incomplete'] &&
        data.errorCount is number && data.errorCount >= 0 &&
        data.storageFilesCount is number && data.storageFilesCount >= 0 &&
        data.totalArchiveBytes is number && data.totalArchiveBytes >= 0 &&
        data.recordCounts is map &&
        (!('storageSummary' in data) || data.storageSummary is map) &&
        (!('errors' in data) || (data.errors is list && data.errors.size() <= 200));
    }

    // Manual Database Backup Logs (strictly Organising Secretary / Admin access only; immutable history)
    match /databaseBackups/{backupId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(backupId) && isValidDatabaseBackup(request.resource.data) && request.resource.data.id == backupId;
      allow update, delete: if false;
    }
  }
}
