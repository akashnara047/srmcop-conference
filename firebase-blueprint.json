{
  "entities": {
    "AbstractSubmission": {
      "title": "AbstractSubmission",
      "description": "Scientific abstract submitted by a participant for conference review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Abstract ID (e.g. AICONDD-ABS-001)" },
        "registrationId": { "type": "string", "description": "Linked Verified Registration ID (e.g. AICONDD001)" },
        "title": { "type": "string", "maxLength": 400, "description": "Title of the scientific abstract" },
        "normalizedTitle": { "type": "string", "maxLength": 400, "description": "Normalized abstract title for duplicate checks" },
        "abstractContentKey": { "type": "string", "maxLength": 128, "pattern": "^ABS_CONTENT_[a-f0-9]{64}$", "description": "Deterministic SHA-256 lock ID for normalized abstract content" },
        "abstractTitleAuthorKey": { "type": "string", "maxLength": 128, "pattern": "^ABS_TITLE_AUTHOR_[a-f0-9]{64}$", "description": "Deterministic SHA-256 lock ID for normalized author email + title" },
        "trackId": { "type": "string", "description": "Scientific track identifier" },
        "presentationPreference": { "type": "string", "enum": ["Oral Presentation", "Poster Presentation", "E-Poster Presentation"] },
        "presentingAuthor": {
          "type": "object",
          "description": "Details of the presenting author (name, email, phone, designation, institution)"
        },
        "coAuthors": {
          "type": "array",
          "description": "List of co-authors"
        },
        "abstractContent": {
          "type": "object",
          "description": "Structured abstract or abstract text content"
        },
        "keywords": {
          "type": "array",
          "description": "3 to 5 keywords"
        },
        "status": { "type": "string", "enum": ["Submitted", "Under Review", "Accepted", "Rejected"] },
        "recordType": { "type": "string", "enum": ["live", "test"] },
        "reviewNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "registrationId", "title", "abstractContentKey", "abstractTitleAuthorKey", "trackId", "presentationPreference", "presentingAuthor", "status", "createdAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Participant conference registration and payment verification record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Internal document ID (e.g. REG-1741...)" },
        "registrationId": { "type": "string", "description": "Official Registration ID (e.g. AICONDD001), generated sequentially upon registration submission" },
        "fullName": { "type": "string", "maxLength": 150 },
        "normalizedFullName": { "type": "string", "maxLength": 150, "description": "Normalized participant name used strictly for duplicate warning comparisons" },
        "nameAdvisoryKey": { "type": "string", "maxLength": 128, "pattern": "^NAME_[a-f0-9]{64}$" },
        "possibleDuplicateNameFlag": { "type": "boolean", "description": "True when submitted with a similar name to an existing registration but distinct verified contact details" },
        "duplicateNameMatchLevel": { "type": "string", "enum": ["none", "similar_name", "same_name_and_institution"] },
        "email": { "type": "string", "format": "email" },
        "normalizedEmail": { "type": "string", "maxLength": 150, "description": "Trimmed lowercase email for atomic uniqueness enforcement" },
        "emailReservationKey": { "type": "string", "maxLength": 128, "pattern": "^EMAIL_[a-f0-9]{64}$" },
        "mobile": { "type": "string", "maxLength": 25 },
        "normalizedMobile": { "type": "string", "maxLength": 32, "description": "Canonical international E.164 mobile number including country code" },
        "mobileReservationKey": { "type": "string", "maxLength": 128, "pattern": "^MOBILE_[a-f0-9]{64}$" },
        "institution": { "type": "string", "maxLength": 250 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "category": { "type": "string" },
        "courseOrDesignation": { "type": "string", "maxLength": 150 },
        "institutionCategory": { "type": "string", "enum": ["internal", "external"], "description": "Participant institution classification (internal or external)" },
        "participationMode": { "type": "string", "enum": ["Offline (On-site at SRMIST)", "Online (Virtual)"] },
        "modeOfParticipation": { "type": "string" },
        "presentationPlan": { "type": "string" },
        "pharmaQuest": { "type": "string" },
        "dietaryPreference": { "type": "string", "enum": ["Vegetarian", "Non-Vegetarian"], "description": "Mandatory food preference collected only for Offline participants" },
        "specialRequirements": { "type": "string" },
        "paymentMode": { "type": "string" },
        "transactionReference": { "type": "string", "maxLength": 120 },
        "normalizedTransactionReference": { "type": "string", "maxLength": 120, "description": "Space-stripped uppercase UTR / transaction reference for duplicate detection" },
        "transactionReferenceKey": { "type": "string", "maxLength": 128, "pattern": "^UTR_[a-f0-9]{64}$", "description": "Deterministic SHA-256 lock document ID in /paymentTransactions" },
        "amount": { "type": "number" },
        "paymentReceiptName": { "type": "string" },
        "paymentReceiptData": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["Pending Verification", "Under Verification", "Verified", "Rejected"] },
        "registrationStatus": { "type": "string", "enum": ["Awaiting Approval", "Approved", "Rejected"] },
        "linkedAbstractId": { "type": "string", "description": "Primary linked Abstract ID if participant submitted one" },
        "linkedAbstractIds": { "type": "array", "description": "All distinct Abstract IDs linked to this participant registration" },
        "abstractSubmitted": { "type": "boolean" },
        "abstractSubmissionDate": { "type": "string", "format": "date-time" },
        "recordType": { "type": "string", "enum": ["live", "test"] },
        "adminRemarks": { "type": "string", "maxLength": 500 },
        "duplicateUtrExceptionApproved": { "type": "boolean", "description": "True only when Organising Secretary explicitly authorised verification despite a duplicate UTR" },
        "duplicateUtrExceptionReason": { "type": "string", "maxLength": 500 },
        "duplicateUtrExceptionApprovedBy": { "type": "string", "maxLength": 150 },
        "duplicateUtrExceptionApprovedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "normalizedEmail", "emailReservationKey", "mobile", "normalizedMobile", "mobileReservationKey", "institution", "category", "transactionReference", "normalizedTransactionReference", "transactionReferenceKey", "paymentStatus", "registrationStatus", "createdAt"]
    },
    "SystemCounter": {
      "title": "SystemCounter",
      "description": "Atomic sequence counter for Registration and Abstract IDs",
      "type": "object",
      "properties": {
        "lastSequenceNumber": { "type": "number", "description": "Highest allocated sequential integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["lastSequenceNumber"]
    },
    "ContactEnquiry": {
      "title": "ContactEnquiry",
      "description": "Visitor contact message and conference enquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Enquiry ID (e.g. ENQ-2027-0042)" },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["New", "Replied", "Archived"] }
      },
      "required": ["id", "name", "email", "subject", "message", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Audit trail of administrator actions for registration and payment verifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminEmail", "action", "targetId", "timestamp"]
    },
    "AccommodationPropertyRecord": {
      "title": "AccommodationPropertyRecord",
      "description": "Verified conference accommodation listing near SRMIST managed by Org. Secretary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "enum": ["Hotel", "Guest House", "Residency", "Homestay"] },
        "locality": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 400 },
        "phone": { "type": "string", "maxLength": 50 },
        "secondaryPhone": { "type": "string", "maxLength": 50 },
        "phoneTypeNote": { "type": "string", "maxLength": 120 },
        "distanceKm": { "type": "number" },
        "driveMinutes": { "type": "number" },
        "mapsQuery": { "type": "string", "maxLength": 300 },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "name", "category", "locality", "address", "phone", "distanceKm", "mapsQuery", "isActive", "updatedAt"]
    },
    "TouristAttractionRecord": {
      "title": "TouristAttractionRecord",
      "description": "Verified regional tourist attraction near SRMIST managed by Org. Secretary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 150 },
        "locality": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 400 },
        "distanceKm": { "type": "number" },
        "driveMinutes": { "type": "number" },
        "image": { "type": "string", "maxLength": 500 },
        "mapsQuery": { "type": "string", "maxLength": 300 },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "name", "locality", "description", "distanceKm", "mapsQuery", "isActive", "updatedAt"]
    },
    "DatabaseBackupRecord": {
      "title": "DatabaseBackupRecord",
      "description": "Lightweight metadata log of manual conference database backups initiated by the Organising Secretary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "filename": { "type": "string", "maxLength": 200 },
        "initiatedBy": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["complete", "incomplete"] },
        "errorCount": { "type": "number" },
        "storageFilesCount": { "type": "number" },
        "totalArchiveBytes": { "type": "number" },
        "recordCounts": { "type": "object" },
        "storageSummary": { "type": "object" },
        "errors": { "type": "array" }
      },
      "required": ["id", "createdAt", "filename", "initiatedBy", "status", "errorCount", "storageFilesCount", "totalArchiveBytes", "recordCounts"]
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Idempotent automated email notification delivery tracking and retry log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["registration_received", "registration_confirmation", "abstract_confirmation", "abstract_acceptance"] },
        "referenceId": { "type": "string", "maxLength": 128 },
        "registrationId": { "type": "string", "maxLength": 128 },
        "regDocId": { "type": "string", "maxLength": 128 },
        "abstractId": { "type": "string", "maxLength": 128 },
        "recipient": { "type": "string", "format": "email", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 250 },
        "status": { "type": "string", "enum": ["Pending", "Sent", "Failed"] },
        "attemptCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "lastAttemptedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "sentAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "error": { "type": "string", "maxLength": 500 },
        "hasAttachment": { "type": "boolean" },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "triggeredBy": { "type": "string", "maxLength": 150 },
        "duplicatePrevented": { "type": "boolean" },
        "providerService": { "type": "string", "maxLength": 120 },
        "recordType": { "type": "string", "enum": ["live", "test"] },
        "timestamp": { "type": "string", "format": "date-time", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": ["id", "eventId", "type", "referenceId", "recipient", "subject", "status", "attemptCount", "createdAt", "lastAttemptedAt", "timestamp"]
    },
    "PaymentTransactionLock": {
      "title": "PaymentTransactionLock",
      "description": "PII-free atomic uniqueness lock for normalized UTR / Payment Transaction IDs across all registrations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^UTR_[a-f0-9]{64}$" },
        "normalizedTransactionReference": { "type": "string", "maxLength": 120 },
        "registrationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": ["id", "normalizedTransactionReference", "registrationId", "createdAt", "updatedAt"]
    },
    "UniquenessReservation": {
      "title": "UniquenessReservation",
      "description": "PII-free atomic uniqueness lock and name-advisory index preventing duplicate emails, international mobile numbers, and repeated identical abstract submissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^(EMAIL|MOBILE|NAME|ABS_CONTENT|ABS_TITLE_AUTHOR)_[a-f0-9]{64}$" },
        "type": { "type": "string", "enum": ["email", "mobile", "name", "abstract_content", "abstract_title_author"] },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerCollection": { "type": "string", "enum": ["registrations", "abstractSubmissions"] },
        "registrationIdsCount": { "type": "number" },
        "institutionHashes": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": ["id", "type", "ownerId", "ownerCollection", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/systemCounters/{counterId}": {
      "schema": "SystemCounter",
      "description": "Atomic sequence counters for generating AICONDDxxx and AICONDD-ABS-xxx IDs"
    },
    "/abstractSubmissions/{abstractId}": {
      "schema": "AbstractSubmission",
      "description": "Submitted abstracts with author and review metadata"
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Attendee registrations and verified payment statuses"
    },
    "/paymentTransactions/{utrKey}": {
      "schema": "PaymentTransactionLock",
      "description": "Atomic uniqueness locks preventing duplicate UTR / payment transaction ID submissions"
    },
    "/uniquenessReservations/{reservationKey}": {
      "schema": "UniquenessReservation",
      "description": "PII-free atomic uniqueness reservations for email, international mobile, name advisory warnings, and abstract content/title deduplication"
    },
    "/contactEnquiries/{enquiryId}": {
      "schema": "ContactEnquiry",
      "description": "Contact form submissions from prospective attendees"
    },
    "/adminAuditLogs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Administrator actions and payment verification logs"
    },
    "/accommodationProperties/{propertyId}": {
      "schema": "AccommodationPropertyRecord",
      "description": "Publicly readable, admin-managed conference accommodation directory entries"
    },
    "/touristAttractions/{attractionId}": {
      "schema": "TouristAttractionRecord",
      "description": "Publicly readable, admin-managed tourist attraction entries"
    },
    "/databaseBackups/{backupId}": {
      "schema": "DatabaseBackupRecord",
      "description": "Admin-only audit metadata for manual full database backups"
    },
    "/emailLogs/{logId}": {
      "schema": "EmailLog",
      "description": "Automated email notification delivery status, duplicate prevention, and retry tracking logs"
    }
  }
}
