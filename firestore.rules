rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'akashnara047@gmail.com' ||
        request.auth.token.email == 'dean.pharmacy.ktr@srmist.edu.in' ||
        request.auth.token.email == 'org.secy.cp@srmist.edu.in' ||
        request.auth.token.email == 'narayanj@srmist.edu.in' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function formatSeq3(n) {
      return n is int && n >= 1
        ? (n < 10 ? ('00' + string(n)) : (n < 100 ? ('0' + string(n)) : string(n)))
        : '';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // System Counters for Atomic Sequential ID Allocation
    // Public registration/abstract transactions may ONLY monotonically increment lastSequenceNumber by +1;
    // arbitrary values, decrements, resets, and deletions remain strictly admin-only.
    match /systemCounters/{counterId} {
      allow read: if true;
      allow create: if (
        counterId in ['abstractCounter', 'registrationCounter'] &&
        request.resource.data.keys().hasAll(['lastSequenceNumber', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['lastSequenceNumber', 'updatedAt']) &&
        request.resource.data.lastSequenceNumber is int &&
        request.resource.data.lastSequenceNumber == 1 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() <= 50
      ) || isAdmin();
      allow update: if (
        counterId in ['abstractCounter', 'registrationCounter'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSequenceNumber', 'updatedAt']) &&
        request.resource.data.lastSequenceNumber is int &&
        resource.data.lastSequenceNumber is int &&
        request.resource.data.lastSequenceNumber == resource.data.lastSequenceNumber + 1 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() <= 50
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Abstract Submissions
    // Public can create abstracts atomically paired with monotonic counter + content + title/author uniqueness reservations
    match /abstractSubmissions/{abstractId} {
      allow create: if isValidId(abstractId) &&
        abstractId.matches('^AICONDD-ABS-[0-9]{3,}$') &&
        request.resource.data.keys().hasAll([
          'id', 'registrationId', 'title', 'abstractContentKey', 'abstractTitleAuthorKey',
          'trackId', 'presentationPreference', 'presentingAuthor', 'status', 'createdAt'
        ]) &&
        request.resource.data.id == abstractId &&
        request.resource.data.status == 'Submitted' &&
        request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 500 &&
        request.resource.data.registrationId is string && request.resource.data.registrationId.size() <= 50 &&
        isValidReservationKey(request.resource.data.abstractContentKey, 'abstract_content') &&
        isValidReservationKey(request.resource.data.abstractTitleAuthorKey, 'abstract_title_author') &&
        abstractId == 'AICONDD-ABS-' + formatSeq3(getAfter(/databases/$(database)/documents/systemCounters/abstractCounter).data.lastSequenceNumber) &&
        getAfter(/databases/$(database)/documents/uniquenessReservations/$(request.resource.data.abstractContentKey)).data.ownerId == abstractId &&
        getAfter(/databases/$(database)/documents/uniquenessReservations/$(request.resource.data.abstractTitleAuthorKey)).data.ownerId == abstractId;

      allow get: if isValidId(abstractId);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Payment Transaction Reference (UTR) Atomic Uniqueness Locks
    // PII-free lock registry preventing duplicate UTR / payment transaction IDs across all registrations
    function isValidUtrKey(utrKey) {
      return utrKey is string && utrKey.matches('^UTR_[a-f0-9]{64}$');
    }

    function isValidPaymentTransactionLock(data, utrKey) {
      return data.keys().hasAll(['id', 'normalizedTransactionReference', 'registrationId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'normalizedTransactionReference', 'registrationId', 'createdAt', 'updatedAt']) &&
        data.id == utrKey &&
        isValidUtrKey(utrKey) &&
        data.normalizedTransactionReference is string &&
        data.normalizedTransactionReference.size() >= 1 &&
        data.normalizedTransactionReference.size() <= 120 &&
        isValidId(data.registrationId) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /paymentTransactions/{utrKey} {
      // Exact-key lookup allows privacy-preserving real-time UTR availability checks without enumerating records
      allow get: if isValidId(utrKey);
      allow list: if isAdmin();
      // Atomic uniqueness guarantee: allow create only fires when document does not yet exist;
      // public creates must pair atomically with a registration write referencing this exact utrKey
      allow create: if isValidUtrKey(utrKey) &&
        isValidPaymentTransactionLock(request.resource.data, utrKey) &&
        (
          isAdmin() ||
          getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.transactionReferenceKey == utrKey
        );
      allow update: if isAdmin() &&
        isValidUtrKey(utrKey) &&
        isValidPaymentTransactionLock(request.resource.data, utrKey);
      // STRICT POLICY: Rejected or pending registrations can NEVER silently free a UTR for another participant.
      // Only authenticated Organising Secretary admins may release a UTR lock after documented investigation/deletion.
      allow delete: if isAdmin() && isValidId(utrKey);
    }

    // Unified PII-Free Atomic Uniqueness Reservations (Email, International Mobile, Name Advisory, Abstract Content/Title)
    function isValidReservationKey(key, type) {
      return key is string && (
        (type == 'email' && key.matches('^EMAIL_[a-f0-9]{64}$')) ||
        (type == 'mobile' && key.matches('^MOBILE_[a-f0-9]{64}$')) ||
        (type == 'name' && key.matches('^NAME_[a-f0-9]{64}$')) ||
        (type == 'abstract_content' && key.matches('^ABS_CONTENT_[a-f0-9]{64}$')) ||
        (type == 'abstract_title_author' && key.matches('^ABS_TITLE_AUTHOR_[a-f0-9]{64}$'))
      );
    }

    function isValidUniquenessReservation(data, key) {
      return data.keys().hasAll(['id', 'type', 'ownerId', 'ownerCollection', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'type', 'ownerId', 'ownerCollection',
          'registrationIdsCount', 'institutionHashes', 'createdAt', 'updatedAt'
        ]) &&
        data.id == key &&
        data.type in ['email', 'mobile', 'name', 'abstract_content', 'abstract_title_author'] &&
        isValidReservationKey(key, data.type) &&
        isValidId(data.ownerId) &&
        data.ownerCollection in ['registrations', 'abstractSubmissions'] &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('registrationIdsCount' in data) || (data.registrationIdsCount is int && data.registrationIdsCount >= 1 && data.registrationIdsCount <= 10000)) &&
        (!('institutionHashes' in data) || (data.institutionHashes is list && data.institutionHashes.size() <= 50));
    }

    match /uniquenessReservations/{reservationKey} {
      // Exact-key get allows zero-PII real-time duplicate checks without listing participant records
      allow get: if isValidId(reservationKey);
      allow list: if isAdmin();

      // Atomic create: allow create only fires when document does not yet exist;
      // public writes must pair atomically with their owning record
      allow create: if isValidUniquenessReservation(request.resource.data, reservationKey) &&
        (
          isAdmin() ||
          (
            request.resource.data.type == 'email' &&
            request.resource.data.ownerCollection == 'registrations' &&
            getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.ownerId)).data.emailReservationKey == reservationKey
          ) ||
          (
            request.resource.data.type == 'mobile' &&
            request.resource.data.ownerCollection == 'registrations' &&
            getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.ownerId)).data.mobileReservationKey == reservationKey
          ) ||
          (
            request.resource.data.type == 'name' &&
            request.resource.data.ownerCollection == 'registrations' &&
            getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.ownerId)).data.nameAdvisoryKey == reservationKey
          ) ||
          (
            request.resource.data.type == 'abstract_content' &&
            request.resource.data.ownerCollection == 'abstractSubmissions' &&
            getAfter(/databases/$(database)/documents/abstractSubmissions/$(request.resource.data.ownerId)).data.abstractContentKey == reservationKey
          ) ||
          (
            request.resource.data.type == 'abstract_title_author' &&
            request.resource.data.ownerCollection == 'abstractSubmissions' &&
            getAfter(/databases/$(database)/documents/abstractSubmissions/$(request.resource.data.ownerId)).data.abstractTitleAuthorKey == reservationKey
          )
        );

      // Admins may update; public transactions may only increment non-blocking 'name' advisory records paired with a new registration
      allow update: if isValidUniquenessReservation(request.resource.data, reservationKey) && (
        isAdmin() ||
        (
          resource.data.type == 'name' &&
          request.resource.data.type == 'name' &&
          request.resource.data.ownerCollection == 'registrations' &&
          request.resource.data.registrationIdsCount is int &&
          (!('registrationIdsCount' in resource.data) || request.resource.data.registrationIdsCount >= resource.data.registrationIdsCount) &&
          getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.ownerId)).data.nameAdvisoryKey == reservationKey
        )
      );

      // Strict policy: only authenticated Organising Secretary admins may release reservations on edit/deletion/reset
      allow delete: if isAdmin() && isValidId(reservationKey);
    }

    // Registration create validation helper
    // Enforces mandatory fields, valid reservation key formats, safe initial status, and blocks forged admin verification metadata
    function isValidRegistrationCreate(data, registrationId) {
      return isValidId(registrationId) &&
        registrationId.matches('^AICONDD[0-9]{3,}$') &&
        data.keys().hasAll([
          'id', 'registrationId', 'fullName', 'email', 'normalizedEmail', 'emailReservationKey',
          'mobile', 'normalizedMobile', 'mobileReservationKey',
          'institution', 'category',
          'transactionReference', 'normalizedTransactionReference', 'transactionReferenceKey',
          'paymentStatus', 'registrationStatus', 'createdAt'
        ]) &&
        data.id == registrationId &&
        data.registrationId == registrationId &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.normalizedEmail is string && data.normalizedEmail.size() >= 3 && data.normalizedEmail.size() <= 150 &&
        isValidReservationKey(data.emailReservationKey, 'email') &&
        data.mobile is string && data.mobile.size() >= 6 && data.mobile.size() <= 40 &&
        data.normalizedMobile is string && data.normalizedMobile.size() >= 8 && data.normalizedMobile.size() <= 32 &&
        isValidReservationKey(data.mobileReservationKey, 'mobile') &&
        data.institution is string && data.institution.size() >= 1 && data.institution.size() <= 250 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 150 &&
        data.transactionReference is string && data.transactionReference.size() >= 1 && data.transactionReference.size() <= 120 &&
        data.normalizedTransactionReference is string && data.normalizedTransactionReference.size() >= 1 && data.normalizedTransactionReference.size() <= 120 &&
        isValidUtrKey(data.transactionReferenceKey) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.paymentStatus in ['Pending Verification', 'Under Verification'] &&
        data.registrationStatus == 'Awaiting Approval' &&
        (!('verifiedBy' in data) || data.verifiedBy == null) &&
        (!('verifiedAt' in data) || data.verifiedAt == null) &&
        (!('adminRemarks' in data) || data.adminRemarks == '' || data.adminRemarks == null) &&
        (!('duplicateUtrExceptionApproved' in data) || data.duplicateUtrExceptionApproved == false) &&
        !('duplicateUtrExceptionReason' in data) &&
        !('duplicateUtrExceptionApprovedBy' in data) &&
        !('duplicateUtrExceptionApprovedAt' in data);
    }

    // Registrations
    // Public (or any signed-in user testing the public form) can create ONLY with:
    // - validated mandatory fields & unverified initial status,
    // - exact next monotonic Registration ID allocated from systemCounters/registrationCounter,
    // - atomic unique Email, Mobile & UTR locks created in the same transaction.
    // Public can get their own registration by ID (no public list to protect PII).
    // Admins can list, update verification/approval status, edit identifiers atomically, and delete.
    match /registrations/{registrationId} {
      allow create: if isValidRegistrationCreate(request.resource.data, registrationId) &&
        registrationId == 'AICONDD' + formatSeq3(getAfter(/databases/$(database)/documents/systemCounters/registrationCounter).data.lastSequenceNumber) &&
        getAfter(/databases/$(database)/documents/paymentTransactions/$(request.resource.data.transactionReferenceKey)).data.registrationId == registrationId &&
        getAfter(/databases/$(database)/documents/uniquenessReservations/$(request.resource.data.emailReservationKey)).data.ownerId == registrationId &&
        getAfter(/databases/$(database)/documents/uniquenessReservations/$(request.resource.data.mobileReservationKey)).data.ownerId == registrationId;

      allow get: if isValidId(registrationId);
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        // Allow abstract submission transaction to link abstract ID(s) to the participant's registration
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'linkedAbstractId', 'linkedAbstractIds', 'abstractSubmitted', 'abstractSubmissionDate', 'updatedAt'
        ])
      ) || (
        // Allow participant to resubmit transaction ref if status was Rejected, enforcing atomic UTR uniqueness
        // (Old rejected UTR lock is NEVER silently deleted for reuse by another participant)
        resource.data.paymentStatus == 'Rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'transactionReference', 'normalizedTransactionReference', 'transactionReferenceKey',
          'paymentReceiptName', 'paymentReceiptData', 'paymentStatus', 'updatedAt'
        ]) &&
        request.resource.data.paymentStatus == 'Pending Verification' &&
        request.resource.data.transactionReference is string && request.resource.data.transactionReference.size() >= 1 && request.resource.data.transactionReference.size() <= 120 &&
        request.resource.data.normalizedTransactionReference is string && request.resource.data.normalizedTransactionReference.size() >= 1 && request.resource.data.normalizedTransactionReference.size() <= 120 &&
        isValidUtrKey(request.resource.data.transactionReferenceKey) &&
        getAfter(/databases/$(database)/documents/paymentTransactions/$(request.resource.data.transactionReferenceKey)).data.registrationId == registrationId
      );
      allow delete: if isAdmin();
    }

    // Contact Enquiries
    match /contactEnquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) &&
        request.resource.data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'createdAt']);
      allow get, list, update, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Validation helpers for Hospitality Directory (Accommodation & Places to Visit)
    function isValidAccommodationProperty(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'locality', 'address', 'phone', 'distanceKm', 'mapsQuery', 'isActive', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'category', 'locality', 'address', 'phone', 'secondaryPhone', 'phoneTypeNote', 'distanceKm', 'driveMinutes', 'mapsQuery', 'isActive', 'updatedAt', 'updatedBy']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        data.category in ['Hotel', 'Guest House', 'Residency', 'Homestay'] &&
        data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 100 &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 400 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 50 &&
        (!('secondaryPhone' in data) || data.secondaryPhone == null || (data.secondaryPhone is string && data.secondaryPhone.size() <= 50)) &&
        (!('phoneTypeNote' in data) || data.phoneTypeNote == null || (data.phoneTypeNote is string && data.phoneTypeNote.size() <= 120)) &&
        data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 500 &&
        (!('driveMinutes' in data) || data.driveMinutes == null || (data.driveMinutes is number && data.driveMinutes >= 0 && data.driveMinutes <= 1000)) &&
        data.mapsQuery is string && data.mapsQuery.size() >= 3 && data.mapsQuery.size() <= 300 &&
        data.isActive is bool &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 150));
    }

    function isValidTouristAttraction(data) {
      return data.keys().hasAll(['id', 'name', 'locality', 'description', 'distanceKm', 'mapsQuery', 'isActive', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'locality', 'description', 'distanceKm', 'driveMinutes', 'image', 'mapsQuery', 'isActive', 'updatedAt', 'updatedBy']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 400 &&
        data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 500 &&
        (!('driveMinutes' in data) || data.driveMinutes == null || (data.driveMinutes is number && data.driveMinutes >= 0 && data.driveMinutes <= 1000)) &&
        (!('image' in data) || data.image == null || (data.image is string && data.image.size() <= 500)) &&
        data.mapsQuery is string && data.mapsQuery.size() >= 3 && data.mapsQuery.size() <= 300 &&
        data.isActive is bool &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 150));
    }

    // Conference Accommodation Directory (public read-only, admin-managed write)
    match /accommodationProperties/{propertyId} {
      allow get: if isValidId(propertyId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(propertyId) && isValidAccommodationProperty(request.resource.data) && request.resource.data.id == propertyId;
      allow update: if isAdmin() && isValidId(propertyId) && isValidAccommodationProperty(request.resource.data) && request.resource.data.id == propertyId;
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    // Tourist Attractions Directory (public read-only, admin-managed write)
    match /touristAttractions/{attractionId} {
      allow get: if isValidId(attractionId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(attractionId) && isValidTouristAttraction(request.resource.data) && request.resource.data.id == attractionId;
      allow update: if isAdmin() && isValidId(attractionId) && isValidTouristAttraction(request.resource.data) && request.resource.data.id == attractionId;
      allow delete: if isAdmin() && isValidId(attractionId);
    }

    // Email Notification Logs (idempotent Pending create, Pending->Sent/Failed completion, Sent immutable, admin retry & audit read)
    function isValidEmailLogCreate(data, logId) {
      return data.keys().hasAll(['id', 'eventId', 'type', 'referenceId', 'recipient', 'subject', 'status', 'attemptCount', 'createdAt', 'lastAttemptedAt', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'eventId', 'type', 'referenceId', 'registrationId', 'regDocId',
          'abstractId', 'recipient', 'subject', 'status', 'attemptCount',
          'createdAt', 'lastAttemptedAt', 'sentAt', 'error', 'hasAttachment',
          'attachmentName', 'triggeredBy', 'duplicatePrevented', 'providerService',
          'recordType', 'timestamp', 'updatedAt'
        ]) &&
        data.id == logId &&
        data.eventId == logId &&
        data.type in ['registration_received', 'registration_confirmation', 'abstract_confirmation', 'abstract_acceptance'] &&
        data.status == 'Pending' &&
        data.attemptCount is int && data.attemptCount == 1 &&
        data.referenceId is string && data.referenceId.size() >= 3 && data.referenceId.size() <= 128 &&
        data.recipient is string && data.recipient.size() >= 3 && data.recipient.size() <= 200 &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 250 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.lastAttemptedAt is string && data.lastAttemptedAt.size() <= 50 &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        (!('sentAt' in data) || data.sentAt == null) &&
        (!('error' in data) || data.error == null) &&
        (!('hasAttachment' in data) || data.hasAttachment is bool) &&
        (!('attachmentName' in data) || data.attachmentName == null || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
        (!('triggeredBy' in data) || (data.triggeredBy is string && data.triggeredBy.size() <= 150)) &&
        (!('duplicatePrevented' in data) || data.duplicatePrevented is bool) &&
        (!('providerService' in data) || data.providerService == null || (data.providerService is string && data.providerService.size() <= 120)) &&
        (!('recordType' in data) || data.recordType in ['live', 'test']);
    }

    function isValidEmailLogUpdate(newData, oldData) {
      return newData.keys().hasOnly([
          'id', 'eventId', 'type', 'referenceId', 'registrationId', 'regDocId',
          'abstractId', 'recipient', 'subject', 'status', 'attemptCount',
          'createdAt', 'lastAttemptedAt', 'sentAt', 'error', 'hasAttachment',
          'attachmentName', 'triggeredBy', 'duplicatePrevented', 'providerService',
          'recordType', 'timestamp', 'updatedAt'
        ]) &&
        newData.id == oldData.id &&
        newData.eventId == oldData.eventId &&
        newData.type == oldData.type &&
        newData.referenceId == oldData.referenceId &&
        newData.createdAt == oldData.createdAt &&
        newData.status in ['Pending', 'Sent', 'Failed'] &&
        newData.attemptCount is int && newData.attemptCount >= 1 && newData.attemptCount <= 50 &&
        newData.lastAttemptedAt is string && newData.lastAttemptedAt.size() <= 50 &&
        (!('sentAt' in newData) || newData.sentAt == null || (newData.sentAt is string && newData.sentAt.size() <= 50)) &&
        (!('error' in newData) || newData.error == null || (newData.error is string && newData.error.size() <= 500));
    }

    function isValidPublicEmailLogCompletion(newData, oldData) {
      return oldData.status == 'Pending' &&
        oldData.type in ['registration_received', 'abstract_confirmation'] &&
        newData.status in ['Sent', 'Failed'] &&
        newData.recipient == oldData.recipient &&
        newData.subject == oldData.subject &&
        newData.attemptCount == oldData.attemptCount;
    }

    match /emailLogs/{logId} {
      allow create: if isValidId(logId) &&
        isValidEmailLogCreate(request.resource.data, logId) &&
        (isAdmin() || request.resource.data.type in ['registration_received', 'abstract_confirmation']);
      allow get, list: if isAdmin();
      allow update: if isValidId(logId) &&
        resource.data.status != 'Sent' &&
        resource.data.status != 'Delivered' &&
        isValidEmailLogUpdate(request.resource.data, resource.data) &&
        (isAdmin() || isValidPublicEmailLogCompletion(request.resource.data, resource.data));
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Validation helper for Database Backup metadata logs
    function isValidDatabaseBackup(data) {
      return data.keys().hasAll(['id', 'createdAt', 'filename', 'initiatedBy', 'status', 'errorCount', 'storageFilesCount', 'totalArchiveBytes', 'recordCounts']) &&
        data.keys().hasOnly(['id', 'createdAt', 'filename', 'initiatedBy', 'status', 'errorCount', 'storageFilesCount', 'totalArchiveBytes', 'recordCounts', 'storageSummary', 'errors']) &&
        isValidId(data.id) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.filename is string && data.filename.size() >= 5 && data.filename.size() <= 200 &&
        data.initiatedBy is string && data.initiatedBy.size() >= 3 && data.initiatedBy.size() <= 150 &&
        data.status in ['complete', 'incomplete'] &&
        data.errorCount is number && data.errorCount >= 0 &&
        data.storageFilesCount is number && data.storageFilesCount >= 0 &&
        data.totalArchiveBytes is number && data.totalArchiveBytes >= 0 &&
        data.recordCounts is map &&
        (!('storageSummary' in data) || data.storageSummary is map) &&
        (!('errors' in data) || (data.errors is list && data.errors.size() <= 200));
    }

    // Manual Database Backup Logs (strictly Organising Secretary / Admin access only; immutable history)
    match /databaseBackups/{backupId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(backupId) && isValidDatabaseBackup(request.resource.data) && request.resource.data.id == backupId;
      allow update, delete: if false;
    }
  }
}
